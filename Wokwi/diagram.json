    [ "esp:3V3", "relayWater:VCC", "red", [] ],
    [ "esp:GND.1", "relayWater:GND", "black", [] ],

    [ "esp:25", "relayCat:IN", "green", [] ],
    [ "esp:3V3", "relayCat:VCC", "red", [] ],
    [ "esp:GND.2", "relayCat:GND", "black", [] ],

    [ "esp:32", "btn1:1.l", "green", [] ],
